# VAJRA AI Backend Configuration

# Web Evidence Retrieval (Required for Tavily search)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Multimodal LLM Verdict & Extraction (Required for Gemini grounded reasoning)
GEMINI_API_KEY=your-gemini-api-key

# Authentication & Security
VAJRA_JWT_SECRET=your-secure-random-jwt-secret

# Verification Cache Configuration (Optional)
VERIFY_CACHE_ENABLED=true
VERIFY_CACHE_TTL_HOURS=24.0
VAJRA_PIPELINE_VERSION=3.0.0
